option(
    'link_pipeline',
    type : 'combo', choices : ['gcc', 'rustc'], value : 'gcc',
    description : 'Select the final-link pipeline: gcc drives the link via devkitA64, rustc drives it via the opt-in rustc-link pipeline',
    yield : true
)

option(
    'use_nx_alloc',
    type : 'feature', value : 'auto',
    description : 'Enable the `alloc` feature',
    yield : true
)

option(
    'use_nx_fsdev',
    type : 'feature', value : 'auto',
    description : 'Enable the `fsdev` feature',
    yield : true
)

option(
    'use_nx_rand',
    type : 'feature', value : 'auto',
    description : 'Enable the `rand` feature',
    yield : true
)

option(
