option(
    'use_nx_service_fs',
    type : 'feature', value : 'auto',
    description : 'Enable the nx-rt-hbapp `service-fs` feature',
    yield : true
)

option(
    'use_nx_romfs',
    type : 'feature', value : 'auto',
    description : 'Enable the nx-rt-hbapp `romfs` feature (the NRO arm of romfsMountSelf)',
