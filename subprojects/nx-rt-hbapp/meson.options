option(
    'link_pipeline',
    type : 'combo', choices : ['gcc', 'rustc'], value : 'gcc',
    description : 'Select the final-link pipeline: gcc drives the link via devkitA64, rustc drives it via the opt-in rustc-link pipeline',
    yield : true
)

option(
    'use_nx_service_apm',
    type : 'feature', value : 'auto',
    description : 'Enable the nx-rt-hbapp `service-apm` feature',
    yield : true
)

option(
    'use_nx_service_applet',
    type : 'feature', value : 'auto',
    description : 'Enable the nx-rt-hbapp `service-applet` feature',
    yield : true
)

