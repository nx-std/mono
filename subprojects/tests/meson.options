option(
    'use_libnx_dkp',
    type : 'feature', value : 'disabled',
    description : 'Use pre-built devkitPro libnx',
    yield : true
)

option(
    'use_nx_std_sync',
    type : 'feature', value : 'auto',
    description : 'Required: tests link against nx-std-sync FFI exports',
    yield : true
)


option(
    'use_nx_sys_net',
    type : 'feature', value : 'auto',
    description : 'Required: the runner serves the netloader protocol through the Rust socket driver',
    yield : true
)
