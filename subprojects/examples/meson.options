# Path to devkitPro (used to resolve $(DEVKITPRO) in libglad / libdrm_nouveau pkg-config files)
option(
    'devkitpro',
    type : 'string', value : '/opt/devkitpro',
    description : 'Path to devkitPro directory',
    yield : true,
)

option(
    'use_libnx_dkp',
    type : 'feature', value : 'disabled',
    description : 'Use pre-built devkitPro libnx',
    yield : true,
)
