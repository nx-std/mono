# Every option this subproject reads, declared here so the `meson.build` beside
# it stands on its own, copied verbatim from the workspace root; `yield : true`
# is what makes the root's value the one that arrives here.

option(
    'link_pipeline',
    type : 'combo', choices : ['gcc', 'rustc'], value : 'gcc',
    description : 'Select the final-link pipeline: gcc drives the link via devkitA64, rustc drives it via the opt-in rustc-link pipeline',
    yield : true,
)
